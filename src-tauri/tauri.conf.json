{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cookbook",
  "version": "0.4.0",
  "identifier": "org.cookbook.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cookbook",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "fullscreen": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MCintelligence",
    "copyright": "Copyright © 2026 MCintelligence",
    "license": "Apache-2.0",
    "homepage": "https://github.com/MCintelligence/Cookbook",
    "category": "Productivity",
    "shortDescription": "An offline writing app with an on-device proofreader",
    "longDescription": "Cookbook is a writing app for novels and long projects. It works offline, needs no account, and keeps your books as plain files on your computer. It has a shelf for chapters and scenes, a pantry for characters, settings and research notes, a smart proofreader that runs on your own device, and Plate mode to set your book like a published novel and export it as EPUB or print-ready PDF.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "editors",
        "desktopTemplate": "linux/cookbook.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/cookbook.desktop"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwRjM5N0FFQUQxRjUyMTUKUldRVlVoK3RycGZ6TVAyQ3owQ2IvTk1oTnNUdk9FbEZEb3BJSzU3QllWbW1YcWVITVZWaUExYkYK",
      "endpoints": [
        "https://github.com/MCintelligence/Cookbook/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
