{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets the app read and write books and their automatic backups in its own data folder and in folders the writer picks, and install signed updates.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-stat",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/books"
        },
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPDATA/backups"
        },
        {
          "path": "$APPDATA/backups/**"
        }
      ]
    }
  ]
}
